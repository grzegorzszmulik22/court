# Toolchain pins for Court. Pinned at M1.1; installed by `make tools` into
# ./.tools/ without root (spec/05-agent-loop.md section 11, tools/host.md).
#
# Go toolchain: downloaded from dl.google.com, sha256-verified per arch.
GO_VERSION=1.27.4
GO_SHA256_LINUX_AMD64=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840
GO_SHA256_LINUX_ARM64=3392582988a273a87ab5043ee1b2c9c17a2c3c00580bf9326c47a2e0aaaeac92
# Windows (Git Bash) since CR-001.
GO_SHA256_WINDOWS_AMD64=178ab98950ac69ab25069307dc6ade79f3816e414cce95b4da166a115cde1e7e

# git and python3 have no upstream linux/arm64 binary distribution and there is
# no C compiler on this host, so `make tools` verifies the system binaries meet
# the pinned floor and links them into .tools/bin (the versions used are
# recorded in .tools/.resolved after install).
GIT_VERSION=2.43.0
PYTHON_VERSION=3.12

# Go module dependencies, mirrored in go.mod.
SQLITE_DRIVER=modernc.org/sqlite
SQLITE_DRIVER_VERSION=v1.62.0
MCP_GO_SDK=github.com/modelcontextprotocol/go-sdk
MCP_GO_SDK_VERSION=v1.8.0

# Recorded only, per the lane note: newest stable version readable from the
# public documentation (code.claude.com changelog, npm dist-tag latest on
# 2026-11-15). Hook payload shapes are recorded at this version in M1.5.
# Never installed or run by `make tools` or any check.
CLAUDE_CODE_VERSION=2.1.325
