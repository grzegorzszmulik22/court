def main(argv):
    # One output format on every OS: text-mode stdout would write CRLF on
    # Windows, so the two verifiers' verdict streams would differ byte for byte.
    sys.stdout.reconfigure(newline="\n")
    sys.stderr.reconfigure(newline="\n")
    args = argv[1:]
    if args and args[0] == "--selftest":
        return selftest()
    hseq, hhash = -1, None
    files = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--head" and i + 1 < len(args):
            spec = args[i + 1]
            s, _, h = spec.partition(":")
            if not s.isdigit() or not HEX64.match(h):
                print("refledger: --head wants <seq>:<64 lowercase hex>, got %r"
                      % spec, file=sys.stderr)
                return 2
            hseq, hhash = int(s), h
            i += 2
            continue
        if a.startswith("--"):
            i += 1
            continue
        files.append(a)
        i += 1
    if not files:
        print("usage: refledger [--head <seq>:<hash>] FILE..."
              " | refledger --selftest", file=sys.stderr)
        return 2
    try:
        schemas = load_schemas()
    except OSError as e:
        print("refledger: cannot load schemas: %s" % e, file=sys.stderr)
        return 2
    bad = 0
    for f in files:
        cls, seq, detail, head, lines = verify_file(f, schemas)
        # A verified ledger prints its head: (seq, hash) of the newest
        # event is the pair a reader keeps, since the chain alone covers
        # only events that have a successor (CR-004).
        if cls == "ok" and head is not None:
            print("VERIFY %s ok head seq=%d hash=%s" % (f, head[0], head[1]))
        elif seq >= 0:
            print("VERIFY %s %s seq=%d %s" % (f, cls, seq, detail))
        else:
            print("VERIFY %s %s" % (f, cls))
        if cls != "ok":
            bad += 1
            continue
        if hseq >= 0:
            fail, appended = check_head(lines, hseq, hhash)
            if fail:
                print("HEAD %s FAIL seq=%d %s" % (f, hseq, fail))
                bad += 1
                continue
            print("HEAD %s ok seq=%d appended=%d" % (f, hseq, len(appended)))
            for ev in appended:
                print("APPENDED %s seq=%d type=%s" % (f, ev["seq_i"], ev["type"]))
    return 1 if bad else 0

if __name__ == "__main__":
    sys.exit(main(sys.argv))
