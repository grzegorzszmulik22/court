def _es6_stream():
    """The published deterministic IEEE-754 generator (testdata numgen)."""
    import struct
    idx = 0
    data = b""
    block = b"\x00" * 32
    while True:
        if idx < len(ES6_STATIC):
            bits = ES6_STATIC[idx]
        elif idx < len(ES6_STATIC) + 2000:
            bits = 0x0010000000000000 + (idx - len(ES6_STATIC))
        else:
            while True:
                if not data:
                    block = hashlib.sha256(block).digest()
                    data = block
                bits = int.from_bytes(data[:8], "little")
                data = data[8:]
                f = struct.unpack("<d", struct.pack("<Q", bits))[0]
                if f != 0 and math.isfinite(f):
                    break
            idx += 1
            yield bits, f
            continue
        idx += 1
        yield bits, struct.unpack("<d", struct.pack("<Q", bits))[0]

def selftest():
    h = hashlib.sha256()
    g = _es6_stream()
    for _ in range(10000):
        bits, f = next(g)
        h.update(("%x,%s\n" % (bits, es6_number(f))).encode())
    got = h.hexdigest()
    if got != ES6_HASH_10000:
        print("SELFTEST FAIL sha256 %s want %s" % (got, ES6_HASH_10000))
        return 1
    print("SELFTEST PASS es6-number-stream sha256=%s" % got)
    return 0

